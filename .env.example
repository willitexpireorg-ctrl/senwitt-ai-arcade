# ---------------------------------------------------------------------------
# Test mode — unlocks all Premium-gated client features (full Games catalog,
# Weekend Deep Set) without Supabase/Stripe. Set to true while playtesting;
# keep false (or unset) for production / real freemium.
# ---------------------------------------------------------------------------
VITE_TEST_MODE=false

# Cloud sync (Supabase). Leave unset to run fully local-only — the app
# works with zero env vars and never crashes without them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — reserved for future client-side Stripe.js use. Checkout in
# Phase 2 is fully server-driven (api/create-checkout-session.ts), so this
# is not required for Stripe to work.
VITE_STRIPE_PUBLISHABLE_KEY=

# Web Push (Phase 4). Leave unset to disable push opt-in entirely — the
# in-app reminder banner + local notifications keep working without it.
# Generate a pair with `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Server-only vars (Vercel project env vars — NEVER exposed to the client,
# NEVER prefixed with VITE_). Required for api/*.ts (Stripe + entitlements).
# ---------------------------------------------------------------------------

# Supabase service role key — server-only, bypasses RLS. Get it from
# Supabase Dashboard > Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
# Falls back to VITE_SUPABASE_URL if unset, but you can set it explicitly.
SUPABASE_URL=

# Stripe (test mode keys while developing: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# Price id for the SENWITT Premium subscription (Product catalog > Pricing).
STRIPE_PRICE_ID=
# From the Stripe CLI (`stripe listen`) or the Dashboard webhook endpoint you create.
STRIPE_WEBHOOK_SECRET=

# OpenAI (Phase 3 — server-only, powers the premium Witt LLM coach in
# api/witt-chat.ts). Never prefix with VITE_ / never expose to the client.
# Without it, api/witt-chat.ts returns 503 and the client falls back to the
# deterministic local tips in src/services/wittLocalReply.ts.
OPENAI_API_KEY=

# Web Push (Phase 4 — server-only, powers api/send-reminders.ts). Must match
# the key pair used for VITE_VAPID_PUBLIC_KEY above (same
# `npx web-push generate-vapid-keys` output).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret for the Vercel Cron job that hits api/send-reminders.ts.
# Vercel automatically sends this as `Authorization: Bearer $CRON_SECRET`
# for cron-triggered requests when the env var is set — see vercel.json.
CRON_SECRET=
